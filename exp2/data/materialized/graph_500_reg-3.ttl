@prefix ex: <http://example.org/br#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:comment """Blast Radius ontology, Experiment 2. Base classes and properties are asserted in the data.\r
Derived classes and properties (marked 'derived') are materialized by the rules in rules.py, run to a\r
fixpoint before any query, so they can be queried like asserted facts. rdf:type is closed under\r
rdfs:subClassOf by the same rules.""" .

ex:availability a owl:DatatypeProperty ;
    rdfs:domain ex:SLA ;
    rdfs:range xsd:decimal .

ex:dependsOnTransitively a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Derived. Transitive dependency: X dependsOnTransitively Y if Y is reachable from X directly or through a chain of dependsOn links." ;
    rdfs:subPropertyOf ex:dependsOn .

ex:deployedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Region .

ex:hasFootprintRegion a owl:ObjectProperty ;
    rdfs:comment "Derived. Footprint: the set of regions where members of a node's replica group are deployed; each such region is a hasFootprintRegion value." ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Region .

ex:hasSLA a owl:ObjectProperty ;
    rdfs:domain ex:Service ;
    rdfs:range ex:SLA .

ex:inReplicaGroupWith a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Derived. Links every component to each member of its replica group, itself included. Replica group: a node plus every node connected to it through replicaOf links in either direction, transitively." .

ex:ownedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Team .

ex:replicaOf a owl:ObjectProperty ;
    rdfs:comment "'X replicaOf Y' means X is a replica of Y." ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Component .

ex:sla-14 a ex:SLA ;
    ex:availability 99.99 .

ex:sla-66 a ex:SLA ;
    ex:availability 99.9 .

ex:sla-99 a ex:SLA ;
    ex:availability 99.95 .

ex:tier a owl:DatatypeProperty ;
    rdfs:comment "Criticality 1-3; 1 is the most critical." ;
    rdfs:domain ex:Service ;
    rdfs:range xsd:integer .

ex:violatesTierRule a owl:ObjectProperty ;
    rdfs:comment "Derived. Tier rule: tier-1 services must not depend directly on tier-3 services; a dependsOn edge from a tier-1 service to a tier-3 service violates the tier rule." ;
    rdfs:domain ex:Service ;
    rdfs:range ex:Service .

ex:FailedRegion a owl:Class ;
    rdfs:comment "Asserted per failure scenario." ;
    rdfs:subClassOf ex:Region .

ex:db-689 a ex:Component,
        ex:Database,
        ex:Primary ;
    ex:deployedIn ex:reg-1 ;
    ex:hasFootprintRegion ex:reg-1 ;
    ex:inReplicaGroupWith ex:db-689 ;
    ex:ownedBy ex:team-12 .

