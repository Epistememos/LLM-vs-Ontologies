ex:CI-28634 a ex:Component,
        ex:Primary,
        ex:Service ;
    ex:dependsOn ex:CI-02495,
        ex:CI-54909,
        ex:CI-55434 ;
    ex:dependsOnTransitively ex:CI-02495,
        ex:CI-45834,
        ex:CI-54909,
        ex:CI-55434 ;
    ex:deployedIn ex:dc-fra ;
    ex:downIn ex:dc-fra ;
    ex:fromRecord src:cmdb-CI-28634 ;
    ex:hasFootprintRegion ex:dc-fra ;
    ex:inReplicaGroupWith ex:CI-28634 ;
    ex:lostIn ex:dc-fra ;
    ex:name "CI-28634",
        "Coupons Gateway Service",
        "cou-gat-svc-v2",
        "coupons_gateway_svc",
        "mon:coupons-gateway" ;
    ex:ownedBy ex:team-identity ;
    ex:tier 1 .

