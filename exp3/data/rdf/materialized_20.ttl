@prefix ex: <http://example.org/br#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix src: <http://example.org/src#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:comment """Blast Radius ontology, Experiment 3. The two exports are loaded as raw records (src:), and the rules in
rules3.py resolve them into one canonical graph (ex:) before any query: entity identity across the exports, the
authority rules, stale-record removal, and the definitions below. Everything marked 'Derived' is materialized and can
be queried like an asserted fact. rdf:type is closed under rdfs:subClassOf.""" .

ex:availability a owl:DatatypeProperty ;
    rdfs:domain ex:SLA .

ex:breachedIn a owl:ObjectProperty ;
    rdfs:comment "Derived. Breached SLA: an SLA is breached if any service that has it is down. 'L breachedIn R' means SLA L is breached if region R fails." ;
    rdfs:range ex:Region .

ex:cmdbOwnerGroup a owl:DatatypeProperty ;
    rdfs:comment "Crosswalk: the CMDB owner group that corresponds to this team." ;
    rdfs:domain ex:Team .

ex:dependsOn a owl:ObjectProperty ;
    rdfs:comment "Derived. Direct dependency: service-to-service from the CMDB, service-to-datastore from monitoring." ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Component .

ex:dependsOnTransitively a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Derived. Transitive dependency: X dependsOnTransitively Y if Y is reachable from X directly or through a chain of dependsOn links." .

ex:deployedIn a owl:ObjectProperty ;
    rdfs:comment "Derived (CMDB datacenter)." ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Region .

ex:downIn a owl:ObjectProperty ;
    rdfs:comment "Derived. Down: a service is down if it is lost or if any node it transitively depends on (via dependsOn) is lost. 'S downIn R' means S is down if region R fails." ;
    rdfs:range ex:Region .

ex:hasFootprintRegion a owl:ObjectProperty ;
    rdfs:comment "Derived. Footprint: the set of regions where members of a node's replica group are deployed; each such region is a hasFootprintRegion value." ;
    rdfs:range ex:Region .

ex:hasSLA a owl:ObjectProperty ;
    rdfs:comment "Derived (monitoring SLA)." ;
    rdfs:domain ex:Service ;
    rdfs:range ex:SLA .

ex:inReplicaGroupWith a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Derived. Replica group: a node plus every node connected to it through replicaOf links in either direction, transitively." .

ex:lostIn a owl:ObjectProperty ;
    rdfs:comment "Derived. Lost: when a region fails, a node is lost if its footprint contains only the failed region. 'X lostIn R' means X is lost if region R fails." ;
    rdfs:range ex:Region .

ex:monitoringZone a owl:DatatypeProperty ;
    rdfs:comment "Crosswalk: the monitoring zone that corresponds to this datacenter." ;
    rdfs:domain ex:Region .

ex:name a owl:DatatypeProperty ;
    rdfs:comment "Derived. Every identifier either export uses for the component: CI ID, CMDB name, monitoring component ID, display name, aliases." .

ex:ownedBy a owl:ObjectProperty ;
    rdfs:comment "Derived (monitoring team)." ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Team .

ex:replicaOf a owl:ObjectProperty ;
    rdfs:comment "Derived (CMDB). 'X replicaOf Y' means X is a replica of Y." ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Component .

ex:tier a owl:DatatypeProperty ;
    rdfs:comment "Derived (CMDB). Criticality 1-3; 1 is the most critical." ;
    rdfs:domain ex:Service .

