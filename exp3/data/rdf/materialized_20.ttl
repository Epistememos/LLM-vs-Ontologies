ex:Queue a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:SLA-BRONZE-02 a ex:SLA ;
    ex:availability 99.99 ;
    ex:breachedIn ex:dc-fra .

ex:SLA-BRONZE-03 a ex:SLA ;
    ex:availability 99.99 ;
    ex:breachedIn ex:dc-fra,
        ex:dc-iad .

ex:SLA-PLATINUM-01 a ex:SLA ;
    ex:availability 99.99 ;
    ex:breachedIn ex:dc-fra .

