        ex:CI-55434 ;
    ex:deployedIn ex:dc-iad ;
    ex:downIn ex:dc-fra,
        ex:dc-iad ;
    ex:fromRecord src:cmdb-CI-72312 ;
    ex:hasFootprintRegion ex:dc-iad ;
    ex:hasSLA ex:SLA-BRONZE-03 ;
    ex:inReplicaGroupWith ex:CI-72312 ;
