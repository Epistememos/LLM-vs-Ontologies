        ex:CI-54909,
        ex:CI-55434 ;
    ex:deployedIn ex:dc-fra ;
    ex:downIn ex:dc-fra,
        ex:dc-iad ;
    ex:fromRecord src:cmdb-CI-29783 ;
    ex:hasFootprintRegion ex:dc-fra ;
    ex:inReplicaGroupWith ex:CI-29783 ;
    ex:lostIn ex:dc-fra ;
    ex:name "CI-29783",
