ex:Primary a owl:Class ;
    rdfs:comment "Derived. Primary: a Service, Database or Queue X is primary if the data has no edge 'X replicaOf Y', i.e. X is not itself a replica of another node." ;
    rdfs:subClassOf ex:Component .

ex:Service a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:dc-sfo a ex:Region ;
    ex:monitoringZone "us-west-2" .

ex:dc-iad a ex:Region ;
    ex:monitoringZone "us-east-1" .

ex:dc-ams a ex:Region ;
    ex:monitoringZone "eu-west-1" .

ex:dc-fra a ex:Region ;
    ex:monitoringZone "eu-central-1" .

src:CmdbRecord a owl:Class ;
    rdfs:comment "One record of the CMDB export (fields: ciId, ciName, ciClass, tier, status, ownerGroup, datacenter, replicaOfCi, dependsOnCi)." .

src:MonRecord a owl:Class ;
    rdfs:comment "One record of the monitoring export (fields: component, displayName, alias, kind, status, team, zone, sla, upstream)." .

ex:Component a owl:Class ;
    rdfs:comment "An infrastructure component: a Service, Database or Queue. Its IRI is ex:<CMDB CI ID>, e.g. ex:CI-12345." .

ex:dc-sin a ex:Region ;
    ex:monitoringZone "ap-southeast-1" .

